{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__tempyr__graph_add_node|mcp__tempyr__graph_update_node|mcp__tempyr__graph_add_edge|mcp__tempyr__interview_commit",
        "hooks": [
          {
            "type": "command",
            "command": "tempyr validate --json --quiet"
          },
          {
            "type": "command",
            "command": "tempyr index update --json"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); if echo \"$INPUT\" | grep -q \"graph/\"; then tempyr index update --json; fi'"
          }
        ]
      }
    ]
  }
}
