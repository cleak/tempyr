# Tempyr Environment Variables
# Copy this file to .env and fill in your values.

# ─── Embedding API Keys ─────────────────────────────────
# Only one is needed, based on your [embedding] provider in .tempyr/config.toml

# Voyage AI (default provider) — https://dash.voyageai.com/
VOYAGE_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Linear Integration ───────────────────────────────
# Get your API key at https://linear.app/settings/api
LINEAR_API_KEY=
